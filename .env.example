# 這是「環境變數樣板」,實際使用時請複製此檔為 .env,並把右邊的值換成真實金鑰。
# .env 已被 .gitignore 排除,不會進版控;.env.example 則會 commit。
# 絕對不要在這個檔案裡填真實的金鑰!

# LINE Channel Secret(在 LINE Official Account Manager → 設定 → Messaging API)
# 用途:驗證 LINE 發來的 webhook 簽章,確認訊息真的是 LINE 發的(防偽造)
LINE_CHANNEL_SECRET=your_channel_secret_here

# LINE Channel Access Token(在 LINE Developers Console → Channel → Messaging API 頁籤)
# 用途:讓我們的後端打 API 給 LINE(例如回覆訊息、傳送通知)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# Supabase Project URL(Supabase 後台 → Settings → API → Project URL)
# 用途:告訴 supabase-py SDK「要連到哪個 Supabase 專案」
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service_role key(Supabase 後台 → Settings → API → Project API keys → service_role)
# 用途:後端用的「超級權限」金鑰,能繞過所有 Row Level Security
# ⚠️ 絕對不能放到前端 JS、絕對不能 commit、洩漏要立刻 regenerate
SUPABASE_KEY=your_service_role_key_here
